# Copie este archivo como ".env" y complete sus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# ---------------------------------------------------------------- Django
DJANGO_DEBUG=True
# Genere una clave con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=America/Guayaquil

# ------------------------------------------------------------ PostgreSQL
POSTGRES_DB=detector_expresiones
POSTGRES_USER=expresiones_app
POSTGRES_PASSWORD=escriba-aqui-su-contrasena
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------- Cámara
# Cámara que usa la aplicación (la interfaz no tiene selector de cámara).
# 0 = la cámara integrada de la computadora; 1, 2... = otras cámaras.
# Para probar sin cámara puede poner la ruta de un video, por ejemplo:
# CAMARA_FUENTE=C:/videos/prueba.mp4. Reinicie el servidor tras cambiarla.
CAMARA_FUENTE=0
# auto = DirectShow, luego Media Foundation (Windows). Opciones: auto, dshow, msmf, any
CAMARA_BACKEND=auto
CAMARA_ANCHO=640
CAMARA_ALTO=480
CAMARA_ESPEJO=True

# ------------------------------------------------- Modelo de emociones FER+
# Probabilidad mínima (0 a 1) para mostrar una expresión MIENTRAS no hay
# línea base (los primeros segundos). Si no se alcanza, se muestra
# "Expresión no clara". Súbala (0.5) si confunde expresiones; bájela (0.3)
# si casi siempre sale "no clara".
CONFIANZA_MINIMA=0.40
# Suavizado entre fotogramas (0 < alfa <= 1). Más alto = responde más rápido
# pero parpadea más.
ALFA_SUAVIZADO=0.5
# Segundos entre registros guardados en PostgreSQL durante una sesión.
INTERVALO_REGISTRO=1

# --------------------- Línea base automática de su cara neutra (ver README)
# Segundos CON rostro visible que se promedian al iniciar la cámara (cara
# relajada) para crear la línea base. 0 = sin línea base (usa CONFIANZA_MINIMA).
DURACION_CALIBRACION=3
# Cuánto debe SUBIR una expresión respecto a la línea base para elegirla
# (0.08 = 8 puntos). Bájelo (0.05) si sus gestos siguen saliendo "Neutral";
# súbalo (0.12) si aparecen expresiones sin hacer gestos.
UMBRAL_CAMBIO=0.08
# Una expresión se muestra si aparece en VENTANA_MINIMO de los últimos
# VENTANA_FOTOGRAMAS fotogramas (evita parpadeos).
VENTANA_FOTOGRAMAS=5
VENTANA_MINIMO=3

# Para ver la línea base y los deltas en vivo: http://127.0.0.1:8000/api/estado/
